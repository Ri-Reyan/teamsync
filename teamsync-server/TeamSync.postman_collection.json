{
  "info": {
    "name": "TeamSync API",
    "description": "Import this collection into Postman. Authentication uses the backend's HTTP-only cookies; keep Postman's cookie jar enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "baseUrlWithoutApiVersion", "value": "http://localhost:5000" },
    { "key": "workspaceId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "sprintId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "invitationId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "stripeSessionId", "value": "" },
    { "key": "demoUserEmail", "value": "user@example.com" },
    { "key": "demoUserPassword", "value": "user1234" },
    { "key": "demoAdminEmail", "value": "admin@example.com" },
    { "key": "demoAdminPassword", "value": "admin1234" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlWithoutApiVersion}}/"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postmanuser\",\n  \"email\": \"new.user@example.com\",\n  \"password\": \"newuser1234\",\n  \"role\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Verify registration email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Login as demo user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoUserEmail}}\",\n  \"password\": \"{{demoUserPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as demo admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoAdminEmail}}\",\n  \"password\": \"{{demoAdminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.user?.id || json?.user?.id;",
                  "if (id) pm.collectionVariables.set('userId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"newPassword\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "List my workspaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace"
          }
        },
        {
          "name": "Create workspace",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Workspace\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.workspace?.id;",
                  "if (id) pm.collectionVariables.set('workspaceId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update workspace",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Demo Workspace\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}"
          }
        },
        {
          "name": "Delete workspace",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}"
          }
        },
        {
          "name": "Leave workspace",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/leave"
          }
        },
        {
          "name": "Transfer ownership",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwnerId\": \"target-user-id\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/transfer-ownership"
          }
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/members"
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/members/{{memberId}}"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project"
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman API Demo Project\",\n  \"description\": \"A project created with Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.project?.id;",
                  "if (id) pm.collectionVariables.set('projectId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated API Demo Project\",\n  \"description\": \"Updated through Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}"
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Sprints",
      "item": [
        {
          "name": "List sprints",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint"
          }
        },
        {
          "name": "Create sprint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint 1 - API Testing\",\n  \"startDate\": \"2026-09-18T00:00:00.000Z\",\n  \"endDate\": \"2026-10-02T23:59:59.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.sprint?.id;",
                  "if (id) pm.collectionVariables.set('sprintId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update sprint",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint 1 - Updated\",\n  \"startDate\": \"2026-09-19T00:00:00.000Z\",\n  \"endDate\": \"2026-10-03T23:59:59.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}"
          }
        },
        {
          "name": "Delete sprint",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}/tasks"
          }
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Verify task creation event\",\n  \"description\": \"Confirm the REST response and realtime update.\",\n  \"status\": \"TODO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.task?.id;",
                  "if (id) pm.collectionVariables.set('taskId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Verify task update event\",\n  \"description\": \"Updated through Postman.\",\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/sprint/{{sprintId}}/tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "Invitations",
      "item": [
        {
          "name": "List invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/invite"
          }
        },
        {
          "name": "Send invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_email\": \"admin@example.com\",\n  \"role\": \"MEMBER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/invite"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.id || json?.data?.invitation?.id;",
                  "if (id) pm.collectionVariables.set('invitationId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/invitations/{{invitationId}}/accept"
          }
        },
        {
          "name": "Cancel invitation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteId\": \"{{invitationId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/invite"
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_prompt\": \"Summarize the current sprint risks and suggest the next three actions.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/ai/chat"
          }
        },
        {
          "name": "Generate project summary",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/ai/summary"
          }
        },
        {
          "name": "Previous conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/workspace/{{workspaceId}}/project/{{projectId}}/ai/conversations"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create checkout session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"package\": \"PROFESSIONAL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/payment/checkout"
          }
        },
        {
          "name": "Confirm payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{stripeSessionId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user/payment/confirm"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/panel/dashboard"
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/panel/users"
          }
        },
        {
          "name": "Suspend user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/admin/panel/users/{{userId}}/suspend"
          }
        }
      ]
    }
  ]
}
