<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to TeamSync</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f3f4f6;
      font-family: &quot;Courier New&quot;, Courier, monospace;
      -webkit-font-smoothing: antialiased;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f3f4f6; padding: 40px 10px"
    >
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 550px;
              background-color: #ffffff;
              border: 4px solid #000000;
              box-shadow: 8px 8px 0px #000000;
              padding: 0;
            "
          >
            <!-- Header Banner -->
            <tr>
              <td
                style="
                  background-color: #ffde00;
                  border-bottom: 4px solid #000000;
                  padding: 30px 20px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    font-size: 32px;
                    font-weight: 900;
                    color: #000000;
                    text-transform: uppercase;
                    letter-spacing: -1px;
                    text-shadow: 2px 2px 0px #ffffff;
                  "
                >
                  TEAMSYNC_
                </h1>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px 30px">
                <h2
                  style="
                    margin: 0 0 16px 0;
                    font-size: 24px;
                    font-weight: 800;
                    color: #000000;
                    text-transform: uppercase;
                  "
                >
                  WELCOME ABOARD, <%= username %>!
                </h2>

                <p
                  style="
                    margin: 0 0 20px 0;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #000000;
                    font-weight: 600;
                  "
                >
                  Your account has been successfully created. You're now ready
                  to join workspaces, manage sprints, and collaborate with your
                  team at breakneck speed.
                </p>

                <!-- Highlight Box / Account Info -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    margin: 25px 0;
                    background-color: #ffe844;
                    border: 3px solid #000000;
                    box-shadow: 4px 4px 0px #000000;
                  "
                >
                  <tr>
                    <td
                      style="
                        padding: 16px;
                        font-size: 14px;
                        font-weight: 700;
                        color: #000000;
                      "
                    >
                      <p style="margin: 0 0 8px 0">
                        <strong>REGISTERED EMAIL:</strong> <%= email %>
                      </p>
                      <p style="margin: 0">
                        <strong>STATUS:</strong>
                        <span
                          style="
                            background-color: #000000;
                            color: #ffde00;
                            padding: 2px 6px;
                          "
                          >ACTIVE</span
                        >
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Call to Action Button -->
                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin: 0 auto 20px auto"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color: #ffde00;
                        border: 3px solid #000000;
                        box-shadow: 5px 5px 0px #000000;
                      "
                    ></td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #000000;
                  color: #ffffff;
                  padding: 20px;
                  text-align: center;
                  border-top: 4px solid #000000;
                "
              >
                <p
                  style="
                    margin: 0 0 6px 0;
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    font-weight: 700;
                  "
                >
                  NO-BS WORKFLOW MANAGEMENT
                </p>
                <p style="margin: 0; font-size: 11px; color: #a1a1aa">
                  If you didn't create this account, please ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
