<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background-color: #fffdf5;
        color: #000000;
        margin: 0;
        padding: 40px 20px;
      }
      .container {
        max-width: 550px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 4px solid #000000;
        padding: 32px;
        box-shadow: 8px 8px 0px 0px #000000;
      }
      .badge {
        display: inline-block;
        background-color: #ffd93d;
        border: 2px solid #000000;
        padding: 4px 8px;
        font-weight: 900;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 16px;
        box-shadow: 2px 2px 0px 0px #000000;
      }
      h1 {
        font-size: 24px;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 16px 0;
        letter-spacing: -0.5px;
      }
      p {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
        color: #333333;
        margin-bottom: 24px;
      }
      .btn-container {
        margin: 32px 0;
      }
      .btn {
        display: inline-block;
        background-color: #4d96ff;
        color: #ffffff !important;
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: none;
        padding: 14px 28px;
        border: 3px solid #000000;
        box-shadow: 4px 4px 0px 0px #000000;
      }
      .footer {
        font-size: 12px;
        font-weight: 700;
        color: #777777;
        border-top: 2px solid #000000;
        padding-top: 16px;
        margin-top: 32px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="badge">Workspace Invitation</div>
      <h1>Join <%= workspaceName %></h1>
      <p>
        <strong><%= sender_id %></strong> has invited you to join the
        <strong><%= workspaceName %></strong> workspace as a
        <strong><%= role %></strong>.
      </p>
      <div class="btn-container">
        <a href="<%= invitationLink %>" class="btn">Accept Invitation →</a>
      </div>
      <p style="font-size: 12px; color: #555">
        If the button doesn't work, copy and paste this link into your
        browser:<br />
        <a href="<%= invitationLink %>" style="color: #000"
          ><%= invitationLink %></a
        >
      </p>
      <div class="footer">
        This invitation was sent automatically. If you were not expecting this,
        you can safely ignore it.
      </div>
    </div>
  </body>
</html>
