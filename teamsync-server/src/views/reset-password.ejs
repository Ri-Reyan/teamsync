<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #fffdf5;
      font-family: &quot;Arial&quot;, sans-serif;
      -webkit-font-smoothing: antialiased;
    "
  >
    <table
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="table-layout: fixed; background-color: #fffdf5; padding: 40px 10px"
    >
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 500px;
              background-color: #ffffff;
              border: 3px solid #000000;
              box-shadow: 6px 6px 0px 0px #000000;
              padding: 32px 24px;
            "
          >
            <!-- Header / Badge -->
            <tr>
              <td align="left" style="padding-bottom: 20px">
                <span
                  style="
                    background-color: #ffd93d;
                    border: 2px solid #000000;
                    color: #000000;
                    font-size: 12px;
                    font-weight: 900;
                    text-transform: uppercase;
                    padding: 6px 12px;
                    display: inline-block;
                    box-shadow: 2px 2px 0px 0px #000000;
                  "
                >
                  🔒 SECURITY ALERT
                </span>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td align="left" style="padding-bottom: 12px">
                <h1
                  style="
                    margin: 0;
                    font-size: 24px;
                    font-weight: 900;
                    text-transform: uppercase;
                    color: #000000;
                    line-height: 1.2;
                  "
                >
                  Reset Your Password
                </h1>
              </td>
            </tr>

            <!-- Description -->
            <tr>
              <td align="left" style="padding-bottom: 24px">
                <p
                  style="
                    margin: 0;
                    font-size: 14px;
                    font-weight: 600;
                    color: #333333;
                    line-height: 1.5;
                  "
                >
                  Hello <%= name %>,
                  <br /><br />
                  We received a request to reset your TeamSync account password.
                  Click the button below to set a new password:
                </p>
              </td>
            </tr>

            <!-- Call To Action Button -->
            <tr>
              <td align="center" style="padding-bottom: 24px">
                <a
                  href="<%= resetUrl %>"
                  target="_blank"
                  style="
                    display: block;
                    width: 100%;
                    box-sizing: border-box;
                    background-color: #ff6b6b;
                    border: 3px solid #000000;
                    color: #ffffff;
                    font-size: 16px;
                    font-weight: 900;
                    text-transform: uppercase;
                    text-decoration: none;
                    text-align: center;
                    padding: 14px 20px;
                    box-shadow: 4px 4px 0px 0px #000000;
                  "
                >
                  RESET PASSWORD
                </a>
              </td>
            </tr>

            <!-- Link Fallback Notice -->
            <tr>
              <td
                align="left"
                style="
                  padding-bottom: 20px;
                  border-top: 2px solid #000000;
                  padding-top: 20px;
                "
              >
                <p
                  style="
                    margin: 0 0 8px 0;
                    font-size: 12px;
                    font-weight: 700;
                    color: #000000;
                  "
                >
                  If the button above doesn't work, copy and paste this link
                  into your browser:
                </p>
                <p
                  style="
                    margin: 0;
                    font-size: 11px;
                    font-weight: 600;
                    word-break: break-all;
                  "
                >
                  <a
                    href="<%= resetUrl %>"
                    style="color: #ff6b6b; text-decoration: underline"
                    ><%= resetUrl %></a
                  >
                </p>
              </td>
            </tr>

            <!-- Warning Message Box -->
            <tr>
              <td
                align="left"
                style="
                  background-color: #fffdf5;
                  border: 2px solid #000000;
                  padding: 12px;
                  box-shadow: 2px 2px 0px 0px #000000;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-size: 11px;
                    font-weight: 700;
                    color: #000000;
                  "
                >
                  ⚠️ This link will expire in <strong>15 minutes</strong>. If
                  you didn't request a password reset, you can safely ignore
                  this email.
                </p>
              </td>
            </tr>
          </table>
          <!-- End Card Container -->

          <!-- Footer -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="max-width: 500px; padding-top: 20px"
          >
            <tr>
              <td
                align="center"
                style="font-size: 11px; font-weight: 700; color: #666666; text-transform: uppercase"
              >
                © <%= new Date().getFullYear() %> TeamSync. All rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
