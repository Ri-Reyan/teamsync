<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f3f4f6;
      font-family: &quot;Courier New&quot;, Courier, monospace;
      -webkit-font-smoothing: antialiased;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f3f4f6; padding: 40px 10px"
    >
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 550px;
              background-color: #ffffff;
              border: 4px solid #000000;
              box-shadow: 8px 8px 0px #000000;
              padding: 0;
            "
          >
            <!-- Header Banner -->
            <tr>
              <td
                style="
                  background-color: #ffde00;
                  border-bottom: 4px solid #000000;
                  padding: 30px 20px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    font-size: 32px;
                    font-weight: 900;
                    color: #000000;
                    text-transform: uppercase;
                    letter-spacing: -1px;
                    text-shadow: 2px 2px 0px #ffffff;
                  "
                >
                  TEAMSYNC_
                </h1>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px 30px">
                <h2
                  style="
                    margin: 0 0 16px 0;
                    font-size: 24px;
                    font-weight: 800;
                    color: #000000;
                    text-transform: uppercase;
                  "
                >
                  VERIFY YOUR EMAIL ADDRESS
                </h2>

                <p
                  style="
                    margin: 0 0 24px 0;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #000000;
                    font-weight: 600;
                  "
                >
                  Hey <%= username %>, enter the verification code below in your
                  app to activate your account.
                </p>

                <!-- Bold OTP Display Box -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    margin: 0 0 25px 0;
                    background-color: #000000;
                    border: 3px solid #000000;
                    box-shadow: 5px 5px 0px #ffde00;
                    text-align: center;
                  "
                >
                  <tr>
                    <td style="padding: 20px">
                      <span
                        style="
                          font-size: 12px;
                          font-weight: 800;
                          color: #a1a1aa;
                          text-transform: uppercase;
                          letter-spacing: 2px;
                          display: block;
                          margin-bottom: 8px;
                        "
                      >
                        VERIFICATION CODE
                      </span>
                      <span
                        style="
                          font-size: 36px;
                          font-weight: 900;
                          color: #ffde00;
                          letter-spacing: 8px;
                        "
                      >
                        <%= otpCode %>
                      </span>
                    </td>
                  </tr>
                </table>
                <!-- Expiry Warning -->
                <p
                  style="
                    margin: 0;
                    font-size: 13px;
                    line-height: 1.5;
                    color: #000000;
                    font-weight: 700;
                    background-color: #f3f4f6;
                    padding: 10px;
                    border: 2px solid #000000;
                  "
                >
                  ⚡ <strong>NOTE:</strong> This code will expire in
                  <strong><%= expiresIn %> minutes</strong>.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #000000;
                  color: #ffffff;
                  padding: 20px;
                  text-align: center;
                  border-top: 4px solid #000000;
                "
              >
                <p
                  style="
                    margin: 0 0 6px 0;
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    font-weight: 700;
                  "
                >
                  AUTHENTICATION SERVICE
                </p>
                <p style="margin: 0; font-size: 11px; color: #a1a1aa">
                  If you didn't request this email, please ignore or contact
                  support.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
